{
    "name": "besmartand-pro/bsap-sensor-bundle",
    "description": "Symfony integration for the BeSmartAnd.Pro Sensor PHP client.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "BeSmartAnd.Pro",
            "email": "hello@BeSmartAnd.Pro",
            "homepage": "https://BeSmartAnd.Pro"
        }
    ],
    "keywords": [
        "sensor",
        "api",
        "temperature",
        "php",
        "symfony",
        "bundle"
    ],
    "require": {
        "php": "^8.4",
        "besmartand-pro/bsap-sensor-client": "~1.0.0",
        "nyholm/psr7": "^1.8",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "require-dev": {
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "besmartand-pro/php-quality-config": "^1.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "BeSmartAndPro\\BsapSensorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BeSmartAndPro\\BsapSensorBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=vendor/besmartand-pro/php-quality-config/phpcs/phpcs.xml src tests config",
        "phpstan": "phpstan analyse -c vendor/besmartand-pro/php-quality-config/phpstan/base.neon src",
        "qa": [
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
